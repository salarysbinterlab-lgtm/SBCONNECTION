# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# .env ถูก gitignore ไว้แล้ว ห้าม commit ขึ้น repo เด็ดขาด
#
# ค่าพวกนี้จะถูก build ติดไปกับไฟล์ JS ที่ผู้ใช้โหลด (เป็นธรรมชาติของ SPA)
# จึงห้ามใส่อะไรที่เป็นความลับจริง ๆ ลงไป
#  - ใส่ได้: publishable / anon key
#  - ห้ามใส่เด็ดขาด: service_role key, Apps Script shared token, รหัสผ่านใด ๆ

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_DRIVE_UPLOAD_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec
